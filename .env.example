# Copy to .env for scripts/dev.py. Never commit the real file.
DATABASE_URL=sqlite:///./data/ea-inversion.db
APP_ORIGIN=http://localhost:3000
API_URL=http://127.0.0.1:8000
COOKIE_SECURE=false
# Optional, server-side only. Required for actual market downloads.
TWELVE_DATA_API_KEY=
# PostgreSQL alternative:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/ea_inversion
# For a hosted HTTPS deployment set APP_ORIGIN to its exact origin and COOKIE_SECURE=true.
